{
  "schema_version": 4,
  "flow_version": "4.0.0",
  "repository": "FelixJI/file-toolbox",
  "default_branch": "main",
  "mode": "manual-handoff",
  "profile": "balanced",
  "worker_tool": "user-selected-zcode-or-pi",
  "control": {
    "cross_tool_start": "human",
    "cross_session_start": "human",
    "technical_owner": "codex",
    "worker_may_pick_next_task": false,
    "automatic_agent_calls": false,
    "automatic_resume": false,
    "progress_polling": false
  },
  "work_scope": {
    "default": "one-authorized-stage",
    "max_active_writers_per_repository": 1,
    "stacked_prs_default": false
  },
  "validation": {
    "commands": [
      "uv sync --frozen --all-extras",
      "uv run --all-extras python scripts/check_release_contract.py",
      "uv run ruff check .",
      "uv run ruff format --check .",
      "uv run mypy",
      "uv run --all-extras python scripts/regen_ui.py --check",
      "uv run pytest --cov=file_toolbox.core --cov-branch --cov-fail-under=90 -W error::ResourceWarning -W error::DeprecationWarning -q",
      "uv run pytest --cov=file_toolbox --cov-branch --cov-fail-under=90 -W error::ResourceWarning -W error::DeprecationWarning -q",
      "uv run --all-extras python scripts/check_test_count.py",
      "uv build --out-dir build/package-validation",
      "uv run --all-extras python scripts/build_exe.py --ci",
      "uv run python scripts/release_smoke.py"
    ],
    "required_check_names": [
      "required"
    ]
  },
  "risk_paths": {
    "review_required": [
      "R0",
      "R1",
      "R2",
      "R3"
    ],
    "human_merge_required": [
      "R0",
      "R1",
      "R2",
      "R3"
    ]
  },
  "review": {
    "independent_codex_session_required": true,
    "human_starts_review_session": true,
    "bind_head_and_base_sha": true,
    "new_commit_requires_recheck": true
  },
  "merge": {
    "mode": "human-only",
    "automatic": false
  },
  "deployment": {
    "authorized": false,
    "real_data_operations_authorized": false
  },
  "retry_policy": {
    "worker_same_root_cause_failed_rounds": 2,
    "codex_same_root_cause_failed_rounds": 2,
    "ci_infrastructure_retries": 1
  },
  "artifact_policy": {
    "task_and_handoff": "github_issue",
    "code_test_review": "github_pr",
    "local_diagnostics": ".ai-flow/runtime/",
    "checkpoint_report_commits": false
  }
}
