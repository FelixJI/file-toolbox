{
  "schema_version": 3,
  "repository": "FelixJI/file-toolbox",
  "default_branch": "main",
  "mode": "native-event-driven",
  "profile": "balanced",
  "max_writers_per_worktree": 1,
  "default_parallel_writers": 1,
  "runner": {
    "max_controller_turns": 24,
    "max_worker_runs_per_task": 8,
    "max_pi_runs_per_task": 2,
    "controller_timeout_seconds": 900,
    "worker_timeout_seconds": 3600,
    "review_timeout_seconds": 1800,
    "preview_chars": 5000,
    "backend": "native"
  },
  "validation": {
    "commands": [
      "uv sync --frozen --all-extras",
      "uv run --all-extras python scripts/check_release_contract.py",
      "uv run ruff check .",
      "uv run ruff format --check .",
      "uv run mypy",
      "uv run --all-extras python scripts/regen_ui.py --check",
      "uv run pytest --cov=file_toolbox.core --cov-branch --cov-fail-under=90 -W error::ResourceWarning -W error::DeprecationWarning -q",
      "uv run pytest --cov=file_toolbox --cov-branch --cov-fail-under=90 -W error::ResourceWarning -W error::DeprecationWarning -q",
      "uv run --all-extras python scripts/check_test_count.py",
      "uv build --out-dir build/package-validation",
      "uv run --all-extras python scripts/build_exe.py --ci",
      "uv run python scripts/release_smoke.py"
    ],
    "required_check_names": [
      "required"
    ]
  },
  "risk_paths": {
    "review_required": [
      "R1",
      "R2",
      "R3"
    ],
    "human_merge_required": [
      "R2",
      "R3"
    ]
  },
  "auto_merge": {
    "enabled": false,
    "allowlisted_categories": [],
    "trusted_gate_verified": false,
    "note": "This package does not implement a remote enforcement gate."
  },
  "deployment": {
    "authorized": false,
    "real_data_operations_authorized": false
  },
  "retry_policy": {
    "pi_same_root_cause_failed_rounds": 2,
    "codex_same_root_cause_failed_rounds": 2,
    "ci_infrastructure_retries": 1
  },
  "flow_version": "3.2.0",
  "artifact_policy": {
    "local_config": ".ai-flow/local.json",
    "runtime_root": ".ai-flow/runtime",
    "publish_progress": "issue_or_pr_summary",
    "checkpoint_commits": false
  }
}
