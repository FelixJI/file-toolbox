      <layout class="QVBoxLayout" name="layout_mappings">
       <item><widget class="QLabel" name="label_mapping_help"><property name="text"><string>内容支持 {{year}}、{{month}}、{{month_start}}、{{month_end}}、{{department}}；分组明细/汇总还支持 {{attendance_group}}</string></property></widget></item>
       <item><widget class="QTableWidget" name="table_mappings"><property name="columnCount"><number>3</number></property><property name="rowCount"><number>0</number></property><column><property name="text"><string>Sheet 名</string></property></column><column><property name="text"><string>单元格</string></property></column><column><property name="text"><string>内容</string></property></column></widget></item>
