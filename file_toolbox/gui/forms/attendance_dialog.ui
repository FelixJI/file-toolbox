          <item row="1" column="1"><widget class="QLineEdit" name="edit_detail_name"/></item>
          <item row="2" column="0"><widget class="QLabel" name="label_detail_matrix"><property name="text"><string>明细矩阵左上角</string></property></widget></item>
          <item row="2" column="1"><widget class="QLineEdit" name="edit_detail_matrix"/></item>
