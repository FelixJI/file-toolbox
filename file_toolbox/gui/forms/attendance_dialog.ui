   <item>
    <widget class="QTabWidget" name="config_tabs">
     <widget class="QWidget" name="tab_layout">
      <attribute name="title"><string>工作表与坐标</string></attribute>
      <layout class="QHBoxLayout" name="layout_coordinates">
       <item>
        <widget class="QGroupBox" name="group_source_layout">
         <property name="title"><string>原始考勤（员工向下、日期向右）</string></property>
