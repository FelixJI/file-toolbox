          <item row="4" column="1"><widget class="QLineEdit" name="edit_summary_name"/></item>
          <item row="5" column="0" colspan="2"><widget class="QCheckBox" name="chk_split_groups"><property name="text"><string>按考勤组拆分（每组自动生成明细/汇总 Sheet）</string></property></widget></item>
